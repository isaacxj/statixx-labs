{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ledger-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["0 12 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ledger",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../drizzle"
    }
  ]
}
